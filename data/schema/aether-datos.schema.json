{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franjuanp.github.io/OkrtSystemLabs/data/schema/aether-datos.schema.json",
  "title": "AETHER · fichero de datos",
  "description": "Instantánea semanal de los indicadores de AETHER. Cada dato lleva valor, unidad, año, fuente, enlace y momento de descarga. Lo valida el trabajo de .github/workflows/datos.yml antes de confirmar el fichero.",
  "type": "object",
  "required": [
    "esquema",
    "generado",
    "fuentes",
    "indicadores",
    "categorias",
    "paises",
    "cobertura"
  ],
  "additionalProperties": false,
  "properties": {
    "esquema": {
      "const": 1
    },
    "generado": {
      "type": "string",
      "format": "date-time"
    },
    "fuentes": {
      "description": "Las fuentes oficiales, con su licencia.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "nombre",
          "corto",
          "url",
          "licencia"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 3
          },
          "corto": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "licencia": {
            "type": "string",
            "minLength": 3
          },
          "licencia_url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "versiones": {
      "description": "Edición concreta de cada fuente que publicó estos datos.",
      "type": "object"
    },
    "indicadores": {
      "description": "El registro: qué es cada indicador y de dónde sale.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "categoria",
          "etiqueta",
          "unidad",
          "fuente",
          "codigo",
          "direccion",
          "url"
        ],
        "properties": {
          "categoria": {
            "type": "string"
          },
          "etiqueta": {
            "type": "string",
            "minLength": 2
          },
          "unidad": {
            "type": "string"
          },
          "fuente": {
            "type": "string"
          },
          "codigo": {
            "type": "string",
            "minLength": 2
          },
          "direccion": {
            "description": "mas_riesgo / menos_riesgo puntúan; ambiguo se muestra pero no entra en el cálculo.",
            "enum": [
              "mas_riesgo",
              "menos_riesgo",
              "ambiguo"
            ]
          },
          "decimales": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "escala": {
            "enum": [
              "lineal",
              "log"
            ]
          },
          "nota": {
            "type": "string",
            "minLength": 20
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "categorias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key",
          "etiqueta",
          "nombre"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "etiqueta": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        }
      }
    },
    "paises": {
      "type": "object",
      "minProperties": 100,
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "nombre",
          "indicadores"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "iso2": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "ingreso": {
            "type": "string"
          },
          "capital": {
            "type": [
              "string",
              "null"
            ]
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "origen_coordenadas": {
            "enum": [
              "capital",
              "centroide"
            ]
          },
          "conflicto": {
            "description": "Desglose del UCDP: muertos en el territorio por tipo de violencia, y muertos en conflictos estatales en los que el gobierno del pais es parte. `base` dice de que tramo salen las cifras: la ventana movil de 12 meses, o el ultimo anio natural cerrado de GED cuando este da mas muertos (Candidate no es acumulativo y deja un hueco en la ventana). No se puntua; lo usan las reglas de nivel minimo.",
            "type": "object",
            "required": [
              "territorio_12m",
              "parte_12m",
              "base",
              "source"
            ],
            "properties": {
              "territorio_12m": {
                "type": "number",
                "minimum": 0
              },
              "estatal_12m": {
                "type": "number",
                "minimum": 0
              },
              "no_estatal_12m": {
                "type": "number",
                "minimum": 0
              },
              "civiles_12m": {
                "type": "number",
                "minimum": 0
              },
              "parte_12m": {
                "type": "number",
                "minimum": 0
              },
              "parte_conflictos": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "media_3anios": {
                "type": "number",
                "minimum": 0
              },
              "desde": {
                "type": "string"
              },
              "hasta": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "version": {
                "type": "string"
              },
              "base": {
                "type": "string",
                "enum": [
                  "ventana_12m",
                  "anio_completo"
                ]
              },
              "anio_base": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ventana_12m": {
                "type": "number",
                "minimum": 0
              },
              "ultimo_anio_completo": {
                "type": "number",
                "minimum": 0
              },
              "candidate_desde": {
                "type": "string"
              }
            }
          },
          "indicadores": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/dato"
            }
          }
        }
      }
    },
    "agregados": {
      "description": "Agregados de referencia (mundo, Unión Europea). Se descargan igual que los países pero NO entran en la distribución con la que se calculan los percentiles: el mundo es la media de todos, y meterlo en la muestra desplazaría el centro de todas las comparaciones.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "nombre",
          "indicadores"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "indicadores": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/dato"
            }
          }
        }
      }
    },
    "global": {
      "description": "Datos que no son de un país: composición de reservas (COFER) y tenedores de deuda de EEUU (TIC).",
      "type": "object",
      "properties": {
        "cofer": {
          "type": "object",
          "required": [
            "periodo",
            "publicado",
            "source",
            "url",
            "monedas"
          ],
          "properties": {
            "periodo": {
              "type": "string",
              "pattern": "^\\d{4}-Q[1-4]$"
            },
            "publicado": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "fetched_at": {
              "type": "string",
              "format": "date-time"
            },
            "monedas": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "nombre"
                ],
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "valorUsd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "porcentaje": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "tic": {
          "type": "object",
          "required": [
            "periodo",
            "unit",
            "source",
            "url",
            "tenedores"
          ],
          "properties": {
            "periodo": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "unit": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "fetched_at": {
              "type": "string",
              "format": "date-time"
            },
            "tenedores": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "object",
                "required": [
                  "nombre",
                  "valor"
                ],
                "properties": {
                  "nombre": {
                    "type": "string"
                  },
                  "valor": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "totales": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "cobertura": {
      "description": "Cuántos países tienen dato en cada indicador. Es lo que permite ver si una fuente ha dejado de responder.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "avisos": {
      "description": "Lo que falló en la descarga. Vacío es lo normal.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sin_fuente": {
      "description": "Territorios que el panel muestra y para los que no hay serie oficial, con el motivo.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "dato": {
      "description": "Un dato, con todo lo necesario para comprobarlo sin salir del fichero.",
      "type": "object",
      "required": [
        "value",
        "unit",
        "year",
        "source",
        "url",
        "fetched_at"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1960,
          "maximum": 2100
        },
        "prev_value": {
          "type": "number"
        },
        "prev_year": {
          "type": "integer",
          "minimum": 1960,
          "maximum": 2100
        },
        "source": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
