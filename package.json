{
  "name": "aether-okrtsystemlabs",
  "version": "0.0.0",
  "private": true,
  "description": "AETHER — sistema publico de inteligencia de riesgos globales (OkrtSystem Labs)",
  "type": "module",
  "scripts": {
    "smoke": "node tests/smoke.mjs --base http://localhost:8080/OkrtSystemLabs",
    "smoke:compare": "node tests/compare.mjs",
    "test:xss": "node tests/xss.mjs --base http://localhost:8080/OkrtSystemLabs",
    "test:watchlist": "node tests/watchlist.mjs --base http://localhost:8080/OkrtSystemLabs",
    "test": "npm run test:xss && npm run test:watchlist && npm run test:coverage && npm run test:paridad && npm run test:vector && npm run test:sw",
    "test:coverage": "node tests/coverage.mjs --base http://localhost:8080/OkrtSystemLabs",
    "test:sw": "node tests/sw.mjs --base http://localhost:8080/OkrtSystemLabs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080 --strictPort",
    "build:hero": "node tools/capture-hero.mjs",
    "build:flags": "node tools/fetch-flags.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "datos": "node tools/fetch-data.mjs",
    "datos:validar": "node tools/validate-data.mjs",
    "test:paridad": "node tests/paridad.mjs --base http://localhost:8080/OkrtSystemLabs",
    "eventos": "node tools/fetch-events.mjs",
    "vector": "node tools/fetch-vector.mjs",
    "test:vector": "node tests/vector.mjs --base http://localhost:8080/OkrtSystemLabs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
